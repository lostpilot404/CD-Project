# Runtime working directory: parser-table cache, exported reports, logs.
# Nothing here is required to build or run the project.
var/

# The interface has no build step and no dependencies: the tests run on Node's
# built-in test runner with a stub DOM.  These are ignored only because a stray
# `npm install` would otherwise add files nobody needs.
node_modules/
package-lock.json
